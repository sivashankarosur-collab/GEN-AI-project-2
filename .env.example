# Copy this file to ".env" (same folder as run.py) and fill in a key to enable real AI.
# Without a key the app still works using the built-in local analyzer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible provider (Groq, OpenRouter, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
